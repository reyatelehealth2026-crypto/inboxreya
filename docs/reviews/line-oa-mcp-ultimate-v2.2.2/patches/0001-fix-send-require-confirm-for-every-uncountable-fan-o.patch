@@ -5,17 +5,29 @@
  * per message above the included allotment. We refuse sends that would consume
  * more than QUOTA_WARN_THRESHOLD of remaining quota unless the caller passes
  * `confirm: true`.
+ *
+ * `projectedMessages` is deliberately `number | "unknown"`. Broadcast and
+ * narrowcast have no pre-send recipient count, and v2.2.2 passed 0 for them —
+ * which made every arithmetic branch below a no-op and let an unbounded,
+ * un-unsendable fan-out through unguarded. "unknown" is now its own case that
+ * always requires `confirm`, so a target shape added later inherits the gate
+ * instead of silently costing nothing.
  */
 
 import { QUOTA_WARN_THRESHOLD } from "../constants.js";
 import { TH } from "../i18n/th.js";
 import type { LineClient } from "./client.js";
-import type { QuotaSnapshot } from "../types.js";
+import type { QuotaSnapshot, SendTransport } from "../types.js";
+
+/** Recipient count a send is expected to cost, or "unknown" when LINE cannot tell us before the send. */
+export type ProjectedMessages = number | "unknown";
 
 export interface QuotaGuardInput {
   client: LineClient;
-  projectedMessages: number;
+  projectedMessages: ProjectedMessages;
   confirm: boolean;
+  /** Transport, used only to word the "unknown" refusal. */
+  transport?: SendTransport;
 }
 
 export interface QuotaGuardOk {
@@ -37,6 +49,22 @@ export async function checkQuota(input: QuotaGuardInput): Promise<QuotaGuardResu
   const snapshot = await snapshotQuota(input.client);
   const warnings: string[] = [];
 
+  // Uncountable fan-out — checked BEFORE the unlimited-plan shortcut on
+  // purpose: the gate exists because the send cannot be recalled, which is
+  // true no matter how much quota the plan carries.
+  if (input.projectedMessages === "unknown") {
+    if (!input.confirm) {
+      return {
+        ok: false,
+        reason: "needs_confirmation",
+        snapshot,
+        message: TH.unboundedFanoutNeedsConfirm(input.transport),
+      };
+    }
+    warnings.push(TH.unboundedFanoutConfirmed(input.transport ?? "narrowcast"));
+    return { ok: true, snapshot, warnings };
+  }
+
   if (snapshot.total === "unlimited") {
     return { ok: true, snapshot, warnings };
   }
