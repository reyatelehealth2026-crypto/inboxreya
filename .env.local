# ============================================================
# Local Development Environment Variables
# สำเนาจาก .env.example — อย่า commit ไฟล์นี้ขึ้น Git!
# ============================================================

# Database
DATABASE_URL="mysql://user:password@host:3306/database_name"
DIRECT_DATABASE_URL="mysql://user:password@host:3306/database_name"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-secure-random-string"

# Internal API Secret (ต้องตรงกับ INTERNAL_API_SECRET ใน odoo config.php)
INTERNAL_API_SECRET="replace-with-secure-random-string"

# PHP API (linepharmachy)
PHP_API_URL="http://localhost"
NEXT_PUBLIC_PHP_API_URL="http://localhost"

# LINE API
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# Redis — Redis Cloud (shared ทั้ง odoo + inboxreya)
# prefix: cny: สำหรับ odoo, inbox: สำหรับ inboxreya
REDIS_URL="redis://default:8aOsi5ZlcevxIxkXOFn4b4qshhMTHKC5@redis-13718.fcrce172.us-east-1-1.ec2.cloud.redislabs.com:13718"
redis://default:8aOsi5ZlcevxIxkXOFn4b4qshhMTHKC5@redis-13718.fcrce172.us-east-1-1.ec2.cloud.redislabs.com:13718
# Pusher (Real-time messaging)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# SlipMate API
SLIPMATE_API_KEY=""

# Node Environment
NODE_ENV="development"
