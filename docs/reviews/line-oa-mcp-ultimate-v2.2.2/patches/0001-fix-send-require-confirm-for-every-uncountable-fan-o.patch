+describe('checkQuota — projectedMessages: "unknown" (broadcast / narrowcast)', () => {
+  // v2.2.2 passed 0 for these transports, which made every branch below a
+  // no-op: 0 can never exceed `remaining`, and 0/remaining can never cross the
+  // 95% threshold. The Guardian returned ok for an unbounded, un-unsendable
+  // send. "unknown" is now its own confirm-gated case.
+  it("without confirm → needs_confirmation, naming the transport", async () => {
+    mockQuota({ value: 1000, used: 0 });
+
+    const res = await checkQuota({
+      client,
+      projectedMessages: "unknown",
+      confirm: false,
+      transport: "narrowcast",
+    });
+
+    expect(res.ok).toBe(false);
+    if (res.ok) return;
+    expect(res.reason).toBe("needs_confirmation");
+    expect(res.message).toBe(TH.unboundedFanoutNeedsConfirm("narrowcast"));
+    expect(res.message).toContain("confirm=true");
+    expect(res.snapshot).toEqual({ used: 0, total: 1000, remaining: 1000, percentage_used: 0 });
+  });
+
+  it("blocks on an UNLIMITED plan too — the gate is irreversibility, not quota", async () => {
+    // The unlimited shortcut returns ok for any numeric projection; "unknown"
+    // must be evaluated BEFORE it, or the whole gate evaporates on the plans
+    // most likely to fan out widely.
+    mockQuota({ used: 12_345, type: "none" });
+
+    const res = await checkQuota({
+      client,
+      projectedMessages: "unknown",
+      confirm: false,
+      transport: "broadcast",
+    });
+
+    expect(res.ok).toBe(false);
+    if (res.ok) return;
+    expect(res.reason).toBe("needs_confirmation");
+    expect(res.message).toContain("Broadcast ถึงทุกคน");
+    expect(res.snapshot.total).toBe("unlimited");
+  });
+
+  it("with confirm → ok, plus a warning that the real count is only knowable after the send", async () => {
+    mockQuota({ value: 1000, used: 0 });
+
+    const res = await checkQuota({
+      client,
+      projectedMessages: "unknown",
+      confirm: true,
+      transport: "broadcast",
+    });
+
+    expect(res.ok).toBe(true);
+    if (!res.ok) return;
+    expect(res.warnings).toEqual([TH.unboundedFanoutConfirmed("broadcast")]);
+  });
+
+  it("omitting `transport` still refuses — it only changes the wording", async () => {
+    mockQuota({ value: 1000, used: 0 });
+
+    const res = await checkQuota({ client, projectedMessages: "unknown", confirm: false });
+
+    expect(res.ok).toBe(false);
+    if (res.ok) return;
+    expect(res.message).toContain("confirm=true");
+    expect(res.message).toContain("broadcast/narrowcast");
+  });
+
+  it("a hard over-quota numeric projection still outranks nothing here — 0 stays a normal count", async () => {
+    // Regression guard: `0` must keep meaning "zero messages", not "unknown".
+    mockQuota({ value: 1000, used: 0 });
+    const res = await checkQuota({ client, projectedMessages: 0, confirm: false });
+    expect(res.ok).toBe(true);
+    if (!res.ok) return;
+    expect(res.warnings).toEqual([]);
+  });
+});
+
