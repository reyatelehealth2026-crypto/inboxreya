--- /dev/null
+++ b/tests/security/client-deadlines.test.ts
@@ -0,0 +1,213 @@
+/**
+ * Security/robustness tests — every LineClient fetch runs under a deadline.
+ *
+ * Two distinct v2.2.2 gaps are pinned here:
+ *
+ *   1. request() armed an AbortController but cleared it in a `finally` that
+ *      ran when the RESPONSE OBJECT arrived — before `response.text()`. A peer
+ *      that flushes headers immediately and then stalls the body therefore had
+ *      no ceiling at all, and the tool call hung indefinitely.
+ *   2. uploadRichMenuImage() and verifyAccessToken() bypass request() (raw
+ *      binary body / query-param auth) and so carried no timeout whatsoever.
+ *
+ * Timers are faked so a 30s/60s deadline costs no wall-clock. Each stalled
+ * promise resolves only via its AbortSignal — if a deadline is ever removed
+ * again these tests hang rather than silently pass, so they carry an explicit
+ * per-test timeout.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import {
+  LINE_REQUEST_TIMEOUT_MS,
+  LINE_UPLOAD_TIMEOUT_MS,
+} from "../../src/constants.js";
+import { LineApiError, LineClient } from "../../src/line/client.js";
+
+const TEST_TIMEOUT_MS = 5_000;
+
+let client: LineClient;
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  client = new LineClient({ channelAccessToken: "deadline-token" });
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+function abortError(): Error {
+  return Object.assign(new Error("This operation was aborted"), { name: "AbortError" });
+}
+
+/** A Response whose headers are already here but whose body never arrives. */
+function stallingBodyResponse(signal: AbortSignal | null | undefined): Response {
+  return {
+    ok: true,
+    status: 200,
+    text: () =>
+      new Promise<string>((_resolve, reject) => {
+        if (signal?.aborted) return reject(abortError());
+        signal?.addEventListener("abort", () => reject(abortError()));
+      }),
+  } as unknown as Response;
+}
+
+/** A JSON Response that behaves normally. */
+function jsonResponse(body: unknown): Response {
+  return {
+    ok: true,
+    status: 200,
+    text: async () => JSON.stringify(body),
+  } as unknown as Response;
+}
+
+type FetchArgs = { input: RequestInfo | URL; init?: RequestInit };
+
+/** Stub global fetch, recording every call. */
+function stubFetch(handler: (args: FetchArgs) => Promise<Response>): FetchArgs[] {
+  const seen: FetchArgs[] = [];
+  vi.stubGlobal("fetch", (input: RequestInfo | URL, init?: RequestInit) => {
+    seen.push({ input, init });
+    return handler({ input, init });
+  });
+  return seen;
+}
+
+describe("request() — the deadline covers the BODY read, not just the headers", () => {
+  it(
+    "a response whose body never arrives is aborted and surfaced as a LineApiError",
+    async () => {
+      stubFetch(async ({ init }) => stallingBodyResponse(init?.signal));
+
+      // v2.2.2: clearTimeout() had already fired by this point, so this promise
+      // never settled — the MCP tool call hung forever.
+      const settled = client.getQuota().then(
+        () => "resolved" as const,
+        (err: unknown) => err,
+      );
+
+      // One tick short of the deadline: still pending.
+      await vi.advanceTimersByTimeAsync(LINE_REQUEST_TIMEOUT_MS - 1);
+      let done = false;
+      void settled.then(() => {
+        done = true;
+      });
+      await Promise.resolve();
+      expect(done).toBe(false);
+
+      await vi.advanceTimersByTimeAsync(2);
+      const err = await settled;
+      expect(err).toBeInstanceOf(LineApiError);
+      expect((err as LineApiError).status).toBe(0);
+      expect((err as LineApiError).message).toContain("Network error");
+    },
+    TEST_TIMEOUT_MS,
+  );
+
+  it("clears its timer on the happy path — no dangling handle per call", async () => {
+    stubFetch(async () => jsonResponse({ type: "limited", value: 500 }));
+
+    const before = vi.getTimerCount();
+    const quota = await client.getQuota();
+
+    expect(quota).toEqual({ type: "limited", value: 500 });
+    expect(vi.getTimerCount()).toBe(before);
+  });
+
+  it("clears its timer when LINE returns an error status too", async () => {
+    stubFetch(async () => ({
+      ok: false,
+      status: 429,
+      text: async () => JSON.stringify({ message: "rate limited" }),
+    }) as unknown as Response);
+
+    await expect(client.getQuota()).rejects.toBeInstanceOf(LineApiError);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+});
+
+describe("uploadRichMenuImage() — raw-binary path is no longer un-timed", () => {
+  it("passes an AbortSignal to fetch", async () => {
+    const seen = stubFetch(async () => ({ ok: true, status: 200 }) as unknown as Response);
+
+    await client.uploadRichMenuImage("richmenu-1", Buffer.from([1, 2, 3]), "image/png");
+
+    expect(seen).toHaveLength(1);
+    expect(seen[0]!.init?.signal).toBeInstanceOf(AbortSignal);
+    expect(vi.getTimerCount()).toBe(0); // and the timer is cleared afterwards
+  });
+
+  it(
+    "a stalled upload aborts at LINE_UPLOAD_TIMEOUT_MS instead of hanging",
+    async () => {
+      stubFetch(
+        ({ init }) =>
+          new Promise<Response>((_resolve, reject) => {
+            init?.signal?.addEventListener("abort", () => reject(abortError()));
+          }),
+      );
+
+      const settled = client
+        .uploadRichMenuImage("richmenu-1", Buffer.from([1, 2, 3]), "image/png")
+        .then(() => "resolved" as const, (err: unknown) => err);
+
+      await vi.advanceTimersByTimeAsync(LINE_UPLOAD_TIMEOUT_MS + 1);
+
+      const err = await settled;
+      expect(err).toBeInstanceOf(LineApiError);
+      expect((err as LineApiError).status).toBe(0);
+    },
+    TEST_TIMEOUT_MS,
+  );
+
+  it("an upload rejected by LINE still surfaces the API status, not a timeout", async () => {
+    stubFetch(async () => ({
+      ok: false,
+      status: 400,
+      text: async () => JSON.stringify({ message: "invalid image" }),
+    }) as unknown as Response);
+
+    const err = await client
+      .uploadRichMenuImage("richmenu-1", Buffer.from([1]), "image/png")
+      .catch((e: unknown) => e);
+
+    expect(err).toBeInstanceOf(LineApiError);
+    expect((err as LineApiError).status).toBe(400);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+});
+
+describe("verifyAccessToken() — query-param auth path is no longer un-timed", () => {
+  it("passes an AbortSignal and clears its timer", async () => {
+    const seen = stubFetch(async () =>
+      jsonResponse({ client_id: "cid", expires_in: 2_592_000 }),
+    );
+
+    const out = await client.verifyAccessToken();
+
+    expect(out.client_id).toBe("cid");
+    expect(seen[0]!.init?.signal).toBeInstanceOf(AbortSignal);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it(
+    "a stalled verify aborts at LINE_REQUEST_TIMEOUT_MS",
+    async () => {
+      stubFetch(async ({ init }) => stallingBodyResponse(init?.signal));
+
+      const settled = client
+        .verifyAccessToken("some-other-token")
+        .then(() => "resolved" as const, (err: unknown) => err);
+
+      await vi.advanceTimersByTimeAsync(LINE_REQUEST_TIMEOUT_MS + 1);
+
+      const err = await settled;
+      expect(err).toBeInstanceOf(LineApiError);
+      expect((err as LineApiError).message).toContain("Network error");
+    },
+    TEST_TIMEOUT_MS,
+  );
+});
