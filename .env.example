# Database
# For Prisma Accelerate: Use Accelerate connection string (optional)
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"
# Direct Database URL (for Prisma CLI: migrate, db push, etc.)
DATABASE_URL="mysql://user:password@host:3306/database_name"
DIRECT_DATABASE_URL="mysql://user:password@host:3306/database_name"
# PHP writes naive DATETIME with date_default_timezone_set('Asia/Bangkok') = +07:00.
# Prisma mysql2 must match. Omit to use fallback +07:00.
DATABASE_MYSQL_TIMEZONE="+07:00"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-secure-random-string"

# Internal API Secret (for syncing from v1/main project)
INTERNAL_API_SECRET="replace-with-secure-random-string"

# PHP API (linepharmachy)
PHP_API_URL="http://localhost"
NEXT_PUBLIC_PHP_API_URL="http://localhost"

# LINE API (for webhook integration)
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# Redis (optional, for caching)
REDIS_URL=""

# Pusher (Real-time messaging)
# Get credentials from https://dashboard.pusher.com
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# Thunder API (Slip Verification)
# Get API key from https://developer.thunder.in.th
THUNDER_API_KEY=""
THUNDER_API_BASE_URL="https://api.thunder.in.th/v2"
EXPECTED_RECEIVER_ACCOUNT="068-3-84622-8"
EXPECTED_RECEIVER_NAME="บริษัท ซี เอ็น วาย เฮลท์แคร์ จำกัด"

# Sentry (error monitoring) — leave SENTRY_DSN blank to no-op
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Build-time source-map upload (optional, only needed in CI)
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# AI rate-limit / budget caps (per-admin hourly + org-wide monthly)
AI_PER_ADMIN_HOURLY_CAP=50
AI_MONTHLY_BUDGET_USD=200
AI_GEMINI_PROMPT_COST_PER_MILLION_USD=0.075
AI_GEMINI_OUTPUT_COST_PER_MILLION_USD=0.3

# line-broadcast Claude Code plugin — no env required.
# Products are fetched from the public CNY HTTP API:
#   https://www.cnypharmacy.com/api/getDataProductIsGroup
# (no auth, no SSH tunnel). See:
#   src/app/api/inbox/broadcasts/cny-products/route.ts
#   .claude/plugins/line-broadcast/skills/cny-products/SKILL.md

# Node Environment
NODE_ENV="development"
# Production: NODE_ENV="production"
