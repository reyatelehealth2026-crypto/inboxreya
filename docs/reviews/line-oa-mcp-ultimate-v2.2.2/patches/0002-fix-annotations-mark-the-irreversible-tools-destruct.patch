+/**
+ * Guardrail tests — MCP tool annotations (`destructiveHint`).
+ *
+ * The host (Claude Code / Cowork / Cursor) reads `destructiveHint` off the
+ * tool listing to decide whether to interrupt the human before a call runs.
+ * A tool that performs an irreversible, outward-facing act while advertising
+ * `destructiveHint: false` disables that prompt — the in-code `confirm` gates
+ * then stand alone, with nothing behind them.
+ *
+ * v2.2.2 shipped `false` on line_send_message (a sent LINE message cannot be
+ * unsent) and on four config tools with delete/clear/discontinue modes. These
+ * assertions pin the corrected values so a new tool cannot regress quietly.
+ *
+ * The listing is read through a real MCP client, so this checks what a host
+ * actually receives — not what the source literal says.
+ */
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+import { isolateConfigEnv, useSingleOaEnv } from "../helpers/env.js";
+import { createTestMcp, type TestMcp } from "../helpers/mcp.js";
+
+let restoreEnv: () => void;
+let mcp: TestMcp;
+let annotations: Map<string, Record<string, unknown>>;
+
+beforeEach(async () => {
+  restoreEnv = isolateConfigEnv();
+  useSingleOaEnv("annotations-token");
+  mcp = await createTestMcp();
+  const { tools } = await mcp.client.listTools();
+  annotations = new Map(
+    tools.map((t) => [t.name, (t.annotations ?? {}) as Record<string, unknown>]),
+  );
+});
+
+afterEach(async () => {
+  await mcp.close();
+  restoreEnv();
+});
+
+/** Tools whose effect cannot be undone from inside this server. */
+const MUST_BE_DESTRUCTIVE: { tool: string; why: string }[] = [
+  { tool: "line_send_message", why: "a sent LINE message cannot be unsent" },
+  { tool: "line_set_webhook_endpoint", why: "re-routes the live bot's inbound traffic" },
+  { tool: "line_set_default_rich_menu", why: "changes/clears the menu every follower sees" },
+  { tool: "line_manage_liff_app", why: 'mode "delete" removes a LIFF app permanently' },
+  { tool: "line_manage_rich_menu_alias", why: 'mode "delete" breaks richmenuswitch actions' },
+  { tool: "line_manage_coupon", why: 'mode "discontinue" ends a live coupon irreversibly' },
+  // Already correct in v2.2.2 — pinned so they stay that way.
+  { tool: "line_delete_rich_menu", why: "deletes a rich menu" },
+  { tool: "line_delete_audience", why: "deletes an audience group" },
+];
+
+describe("destructiveHint is set on every irreversible tool", () => {
+  it.each(MUST_BE_DESTRUCTIVE)("$tool — $why", ({ tool }) => {
+    expect(annotations.has(tool)).toBe(true);
+    expect(annotations.get(tool)!.destructiveHint).toBe(true);
+  });
+});
+
+describe("read-only tools stay non-destructive", () => {
+  const READ_ONLY = [
+    "line_get_oa_status",
+    "line_list_rich_menus",
+    "line_list_audiences",
+    "line_get_message_stats",
+    "line_list_followers",
+    "line_list_oas",
+  ];
+
+  it.each(READ_ONLY)("%s is not flagged destructive", (tool) => {
+    expect(annotations.has(tool)).toBe(true);
+    expect(annotations.get(tool)!.destructiveHint).toBe(false);
+  });
+});
+
+describe("every registered tool declares the annotation at all", () => {
+  it("no tool leaves destructiveHint undefined — hosts treat missing as unknown", () => {
+    const missing = [...annotations.entries()]
+      .filter(([, a]) => typeof a.destructiveHint !== "boolean")
+      .map(([name]) => name);
+    expect(missing).toEqual([]);
+  });
+});
