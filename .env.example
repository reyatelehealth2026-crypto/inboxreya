# Database
# For Prisma Accelerate: Use Accelerate connection string (optional)
# DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_API_KEY"
# Direct Database URL (for Prisma CLI: migrate, db push, etc.)
DATABASE_URL="mysql://user:password@host:3306/database_name"
DIRECT_DATABASE_URL="mysql://user:password@host:3306/database_name"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-secure-random-string"

# Internal API Secret (for syncing from v1/main project)
INTERNAL_API_SECRET="replace-with-secure-random-string"

# PHP API (linepharmachy)
PHP_API_URL="http://localhost"
NEXT_PUBLIC_PHP_API_URL="http://localhost"

# LINE API (for webhook integration)
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# Redis (optional, for caching)
REDIS_URL=""

# Pusher (Real-time messaging)
# Get credentials from https://dashboard.pusher.com
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# SlipMate API (Slip Verification)
# Get API key from https://apps.slipmate.ai
SLIPMATE_API_KEY=""

# Node Environment
NODE_ENV="development"
# Production: NODE_ENV="production"
