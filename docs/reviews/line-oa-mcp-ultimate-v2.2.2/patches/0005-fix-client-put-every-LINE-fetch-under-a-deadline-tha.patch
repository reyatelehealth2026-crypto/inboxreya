+/**
+ * Wrap a transport-level failure (DNS, TLS, socket, or our own abort) in the
+ * same LineApiError shape callers already handle, so a timeout surfaces as a
+ * Thai tool error rather than a raw AbortError escaping the client.
+ */
+function networkError(err: unknown): LineApiError {
+  const msg = err instanceof Error ? err.message : String(err);
+  return new LineApiError(0, { message: `Network error: ${msg}` });
+}
